rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────
    // Everything here trusts request.auth.token.* (Custom Claims set by
    // the syncMyClaims Cloud Function), NOT any data read from Firestore
    // itself at rule-evaluation time - that's what makes this the real
    // security boundary instead of another copy of the client-side check.
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email; }
    function myCompanyId() { return request.auth.token.companyId; }
    function myRole() { return request.auth.token.role; }
    function hasFullAccess() {
      return signedIn() && (
        myRole() in ['Owner', 'Project Manager', 'Accounting'] ||
        request.auth.token.fullAccessOverride == true
      );
    }
    function inCompany(companyId) {
      return signedIn() && myCompanyId() == companyId;
    }
    // Only these domains may create a new company doc (onboarding).
    // Keep in sync with SIGNUP_ALLOWED_DOMAINS in kytrac-app.js.
    // matches() is a full-string match (RE2), so patterns cover the
    // whole email; [.] avoids escape ambiguity.
    function allowedSignupDomain() {
      return signedIn() && (
        myEmail().lower().matches('.*@7pillarsgroup[.]org') ||
        myEmail().lower().matches('.*@jtxdgroup[.]com')
      );
    }

    // ── Collection-group access for cross-job queries ───────────────
    // Dedicated rule so collectionGroup('logs') queries (Home dashboard's
    // "Logs Today" stat, the Global Logs admin feed) actually work.
    // The nested per-job match further down does NOT cover collection-
    // group queries on its own -- Firestore requires this separate
    // {path=**} rule even though it's the same underlying documents.
    // Scoped by the companyId every log document already carries via
    // subDoc(), same tenant-isolation model as the rest of this file.
    match /{path=**}/logs/{logId} {
      allow read: if inCompany(resource.data.companyId);
    }

    // ── Top-level companies collection ──────────────────────────────
    // Needed for company resolution (resolveCompany() / syncMyClaims)
    // before a user necessarily has companyId claims yet on first login,
    // so this checks email match directly against the doc as a fallback
    // in addition to the claim check.
    match /companies/{companyId} {
      allow read: if signedIn() && (
        resource.data.ownerEmail == myEmail().lower() ||
        myEmail().lower() in resource.data.memberEmails ||
        inCompany(companyId)
      );
      // Onboarding: a signed-in user creating their own new company —
      // restricted to approved business domains so stray Google accounts
      // can't spin up companies (real enforcement; the client-side check
      // in resolveCompany is just UX).
      allow create: if allowedSignupDomain() && request.resource.data.ownerEmail == myEmail().lower();
      // Updates (memberEmails arrayUnion/arrayRemove from Team Management,
      // plan changes, etc.) restricted to that company's own full-access users.
      allow update: if inCompany(companyId) && hasFullAccess();
      allow delete: if false; // no client-side company deletion, ever

      // ── Settings (team roster, company profile, markup/burden/OT config) ──
      match /settings/team {
        // Readable by any company member (needed for @mention roster,
        // role display, etc.) - writable by Owner only, matching the
        // client-side boundary that already existed for Team Management.
        allow read: if inCompany(companyId);
        allow write: if inCompany(companyId) && myRole() == 'Owner';
      }
      match /settings/company {
        // Portal reads this anonymously for branding (logo, name, phone).
        allow read: if inCompany(companyId) || request.auth == null;
        allow write: if inCompany(companyId) && hasFullAccess();
      }
      match /settings/{doc} {
        allow read: if inCompany(companyId);
        allow write: if inCompany(companyId) && hasFullAccess();
      }

      // ── Pulse history (daily snapshot of activeJobs/outstandingInvoices/
      // unprocessedCOs, written client-side, read by the dailyKpiRefresh
      // Cloud Function to compute a week-over-week trend for PlannerXD's
      // Weekly Pulse). Non-sensitive aggregate counts only.
      match /pulseHistory/{dateStr} {
        allow read, write: if inCompany(companyId);
      }

      // ── Google Calendar OAuth tokens ──
      // Refresh tokens are real credentials (equivalent to a password for
      // that person's calendar) - NEVER client-readable, regardless of
      // role or fullAccessOverride. Only Cloud Functions touch this
      // (Admin SDK bypasses rules entirely). The client only ever sees a
      // boolean 'googleCalendarConnected' flag on the team member record,
      // which is a separate, non-sensitive field.
      match /googleCalendarTokens/{uid} {
        allow read, write: if false;
      }

      // ── QuickBooks OAuth tokens ──
      // Same treatment as googleCalendarTokens above: this holds real
      // access/refresh credentials for the WHOLE company's QuickBooks
      // account (not one person's), so it's never client-readable
      // regardless of role or fullAccessOverride. The client only ever
      // sees the non-sensitive status doc at settings/quickbooks
      // (realmId, environment, a plain 'connected' boolean).
      match /quickbooksTokens/{docId} {
        allow read, write: if false;
      }

      // ── Stripe secret key (per-company, mirrors quickbooksTokens) ──
      // Holds an encrypted Stripe secret key + webhook signing secret
      // for this company's OWN connected Stripe account. Never
      // client-readable regardless of role -- the client only ever
      // sees the non-sensitive status doc at settings/stripe
      // (connected boolean, key mode, when connected).
      match /stripeTokens/{docId} {
        allow read, write: if false;
      }

      // ── Customers ──
      // NOTE: this collection had no rule at all before this pass -
      // loadCustomers()/renderCustomers() in kytrac-app.js read
      // companies/{companyId}/customers directly, which would have
      // been silently permission-denied under Firestore's default-deny
      // (the Customers page likely hasn't been working). Same access
      // level as the jobs doc itself: any signed-in company member can
      // read/write, since assigning jobs to customers is a normal
      // team-wide action, not a financial one.
      match /customers/{customerId} {
        allow read, write: if inCompany(companyId);
      }

      // ── Calendar events (personal, assignee-based) ──
      // NOTE: same gap as customers above - this collection had no
      // rule at all, so loadCalendarEvents()/saveCalendarEvent() in
      // kytrac-app.js were silently permission-denied under Firestore's
      // default-deny. This is also the collection pushPersonalEventToGCal
      // (Cloud Function) triggers on, so it needed a real rule before
      // the Google Calendar integration could ever be tested end to end.
      // Any signed-in company member can read/write - scheduling a
      // meeting and assigning it to a teammate is a normal team-wide
      // action, same boundary as the jobs doc itself.
      match /calendarEvents/{eventId} {
        allow read, write: if inCompany(companyId);
      }

      // ── Todos, Vendors, Documents, Templates ──
      // Same gap as customers/calendarEvents above - none of these had
      // ANY rule, found by cross-checking every coll('X') call in
      // kytrac-app.js against what firestore.rules actually covers.
      // General team-collaboration data, same access level as jobs.
      match /todos/{todoId} {
        allow read, write: if inCompany(companyId);
        allow create: if request.auth == null
          && request.resource.data.source == 'proposal_signed'
          && request.resource.data.companyId == companyId;
      }
      match /vendors/{vendorId} {
        allow read, write: if inCompany(companyId);
        // Bills subcollection needs its OWN rule — Firestore rules do
        // NOT cascade from a parent match block to its subcollections.
        // This was missing entirely, so every write to
        // vendors/{vendorId}/bills/{billId} was silently denied by
        // default regardless of the parent rule above, from any entry
        // point (vendor page or job Financials shortcut) — this
        // feature never actually worked until this rule was added.
        match /bills/{billId} {
          allow read, write: if inCompany(companyId);
        }
      }
      // Same exact gap as vendors above, repeated on the newer
      // Contractors collection — no rule at all was written for it
      // when it was built, so every save silently failed with
      // "Missing or insufficient permissions" until this was added.
      // No subcollection here (unlike vendors/bills) since
      // subcontractorPayments deliberately stayed job-scoped under
      // jobs/{jobId}/subcontractorPayments, already covered below.
      match /contractors/{contractorId} {
        allow read, write: if inCompany(companyId);
      }
      match /documents/{docId} {
        allow read, write: if inCompany(companyId);
        // Portal (anonymous) can create signed proposal documents only
        allow create: if request.auth == null
          && request.resource.data.source == 'proposal_signature'
          && request.resource.data.companyId == companyId;
      }
      match /templates/{templateId} {
        allow read, write: if inCompany(companyId);
      }

      // ── EOS (Entrepreneurial Operating System) tracking ──
      // Same gap - Rocks, Issues, and Scorecard are leadership-team
      // planning tools, but nothing in the app currently restricts
      // them to a leadership role, so matching the same open-to-team
      // boundary as everything else above rather than inventing a new
      // restriction that isn't reflected in the UI.
      match /eosRocks/{rockId} {
        allow read, write: if inCompany(companyId);
      }
      match /eosIssues/{issueId} {
        allow read, write: if inCompany(companyId);
      }
      match /eosScorecardMetrics/{metricId} {
        allow read, write: if inCompany(companyId);
      }

      // ── Purchase Orders ──
      // Same gap, but treated as money-sensitive like invoices/change
      // orders elsewhere in this file (hasFullAccess-gated), since a PO
      // is a financial commitment to a vendor, not general team data.
      match /purchaseOrders/{poId} {
        allow read, write: if inCompany(companyId) && hasFullAccess();
      }

      // ── Catalog (pricing data) ──
      match /catalog/{catId} {
        allow read: if inCompany(companyId);
        allow write: if inCompany(companyId) && hasFullAccess();
      }

      // ── Time entries (clock in/out, manual, overtime calc) ──
      match /timeentries/{entryId} {
        // Any team member can log their own time and read the shared log
        // (Weekly Overtime already reads across everyone company-wide).
        allow read, write: if inCompany(companyId);
      }

      // ── Jobs and everything under them ──
      match /jobs/{jobId} {
        // NOTE ON PORTAL ACCESS: the Customer Portal reads this same
        // path anonymously (no request.auth at all - access is by
        // knowing a random token in their link, not by signing in).
        // Firestore rules have no way to verify "this anonymous reader
        // already holds a valid token for this specific job" - there's
        // no session state carried between the portalTokens read and
        // this one, and the token string isn't part of this request's
        // path/resource for a rule to check. Cryptographically closing
        // this gap would mean moving portal reads behind a callable
        // Cloud Function (token validated server-side via Admin SDK,
        // which bypasses these rules) instead of direct client reads -
        // a real refactor of loadPortalJob() in kytrac-app.js, flagged
        // here as a good follow-up, not attempted in this pass since I
        // can't test it against your live portal links from this
        // session. For now this allows anonymous read so portal links
        // keep working exactly as they do today - no more open than the
        // current (rules-less) deployment, while the authenticated
        // team-member side below is the part that's actually tightened.
        allow read: if inCompany(companyId) || request.auth == null;
        // Any authenticated team member can update job fields (status,
        // notes - daily logs live under here too). Anonymous portal
        // writes are scoped narrowly in the specific subcollections
        // below, EXCEPT for this one case: submitPortalSignature()
        // (kytrac-app.js) auto-advances a job to 'To Be Scheduled' the
        // moment a customer signs, writing status/statusDate/
        // lastActivity/lastActivityNote directly on this document.
        // Originally targeted 'Approved', but that status was removed
        // as a distinct pipeline stage — signing now goes straight to
        // To Be Scheduled. Scoped tightly: only those 4 fields, and
        // only when setting status specifically to 'To Be Scheduled' —
        // anonymous visitors still can't touch pricing, contact info,
        // or set any other status.
        allow write: if inCompany(companyId) ||
          (request.auth == null &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'statusDate', 'lastActivity', 'lastActivityNote']) &&
           request.resource.data.status == 'To Be Scheduled');

        // Money-sensitive subcollections: full-access roles only.
        // NOTE (known limitation): this locks the whole collection, but
        // Firestore rules can't hide individual FIELDS within a doc a
        // role is otherwise allowed to read - e.g. estimate line items
        // still carry unitCost/unitPrice on the same doc a Field Tech
        // might need to read for qty/description. True field-level
        // price-hiding would need those split into a separate
        // sub-document with its own rules - a bigger schema change than
        // this pass covers. Flagged, not silently ignored.
        match /invoices/{invId} {
          // Portal displays invoices when share is enabled - read open to
          // anonymous for the same reason as the job doc above; writes
          // (marking paid, etc.) stay team-only.
          allow read: if inCompany(companyId) && hasFullAccess() || request.auth == null;
          allow write: if inCompany(companyId) && hasFullAccess();
        }
        match /expenses/{expenseId} {
          // Materials purchases (e.g. a team member buying drywall at
          // Home Depot on the company debit card) — job-scoped, no
          // vendor account involved. Same access tier as invoices/COs
          // since it's money-sensitive.
          allow read, write: if inCompany(companyId) && hasFullAccess();
        }
        match /subcontractorPayments/{payId} {
          // Flat-rate 1099 job payments (e.g. Domingo Handyman LLC paid
          // $20,400 for a defined scope) — separate from Vendor Bills
          // (needs a formal vendor account) and from clock-in/out hours
          // (for a flat-rate person, informational only, not what's
          // owed). Same access tier as expenses above.
          allow read, write: if inCompany(companyId) && hasFullAccess();
        }
        match /changeorders/{coId} {
          allow read: if inCompany(companyId) && hasFullAccess() || request.auth == null;
          allow write: if inCompany(companyId) && hasFullAccess();
        }
        match /proposals/{propId} {
          // Portal both reads (view proposal) AND writes (e-signature
          // capture, decline) here anonymously - same bearer-token
          // caveat as the job doc above applies to both directions.
          allow read: if inCompany(companyId) && hasFullAccess() || request.auth == null;
          allow write: if (inCompany(companyId) && hasFullAccess()) || request.auth == null;
        }
        match /lienWaivers/{waiverId} {
          // Team members create waivers; portal visitors (anonymous) update
          // them to capture signatures/declines.
          allow read: if inCompany(companyId) || request.auth == null;
          allow create: if inCompany(companyId);
          allow update: if inCompany(companyId) || request.auth == null;
          allow delete: if false;
        }
        match /timeOffRequests/{requestId} {
          // Any team member can create and read their own requests.
          // Only owners/full access can update (approve/deny).
          allow read: if inCompany(companyId);
          allow create: if inCompany(companyId);
          allow update: if inCompany(companyId) && hasFullAccess();
          allow delete: if false;
        }
        match /kpiCache/{docId} {
          // Dashboard KPI cache — readable by all team members, written by Cloud Functions only
          allow read: if inCompany(companyId);
          allow write: if false; // Cloud Functions use Admin SDK, bypasses rules
        }
        match /jobNotes/{noteId} {
          // PM paper trail — immutable once saved, author or owner can delete.
          allow read: if inCompany(companyId);
          allow create: if inCompany(companyId);
          allow delete: if inCompany(companyId) && hasFullAccess();
          allow update: if false;
        }
        match /estimateGroups/{groupId} {
          allow read, write: if inCompany(companyId);
          match /items/{itemId} {
            allow read, write: if inCompany(companyId);
          }
          match /subgroups/{subId} {
            allow read, write: if inCompany(companyId);
            match /items/{itemId} {
              allow read, write: if inCompany(companyId);
            }
            match /subgroups/{subSubId} {
              allow read, write: if inCompany(companyId);
              match /items/{itemId} {
                allow read, write: if inCompany(companyId);
              }
            }
          }
        }

        // Everything else under a job - phases, logs, messages, photos,
        // to-dos, etc. Open to any company member; portal also reads
        // (phases, logs) and writes (messages) here anonymously, same
        // bearer-token caveat as above.
        match /{subcollection}/{docId} {
          allow read, write: if inCompany(companyId) || request.auth == null;
        }
      }
    }


    // ── User Read State (notification tracking) ──
    match /userReadState/{userEmail}/{type}/{docId} {
      allow read, write: if signedIn() && myEmail().lower().replace('.','_') == userEmail;
    }
    // ── Customer Portal (anonymous, bearer-token model) ─────────────
    // Portal visitors are NOT signed in - access is by knowing the
    // random token in their link, not by auth. This is inherently a
    // different security model than the rest of the app.
    //
    // IMPORTANT CAVEAT: I could not test these portal rules against the
    // live app in this session (no deploy access from this environment).
    // The paths below mirror exactly what loadPortalJob()/sendPortalMessage()
    // in kytrac-app.js already read/write. Please click through an actual
    // portal link right after deploying to confirm it still loads, signs,
    // and sends messages correctly - if anything breaks, the likely fix is
    // loosening one of these specific matches, not the authenticated rules
    // above.
    match /portalTokens/{token} {
      // Anonymous portal visitors read by knowing the token (bearer-token
      // model - see the caveat on the jobs match above).
      allow read: if true;
      // shareCustomerPortal() in kytrac-app.js writes these directly from
      // the browser when a team member generates a share link - NOT via
      // a Cloud Function as originally assumed here, which is what broke
      // link generation on first deploy. Any authenticated team member
      // can create/update a token for their own company's job.
      allow create, update: if signedIn() && request.resource.data.companyId == myCompanyId();
      allow delete: if false;
    }

    // PlannerXD notification bridge — UID-keyed
    // JOBSMETRIX writes to plannerxd_notifications/{ownerUid}/items
    // PlannerXD reads/marks-read from the same path.
    // UID in the path is the scope; open read/update, authenticated create.
    match /plannerxd_notifications/{ownerUid}/items/{itemId} {
      allow read, update: if true;
      allow create: if signedIn() || request.auth == null;
    }

    // PlannerXD pulse sync — UID-keyed, single rollup doc per owner.
    // JOBSMETRIX writes a handful of live dashboard numbers here
    // (activeJobs, outstandingInvoices, unprocessedCOs); PlannerXD
    // reads it into Weekly Pulse. Same open-read/authenticated-write
    // pattern as plannerxd_notifications above — low-sensitivity
    // aggregate counts, not per-job detail.
    match /plannerxd_pulse_sync/{ownerUid} {
      allow read: if true;
      allow write: if signedIn();
    }
  }
}
